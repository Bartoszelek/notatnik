<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ek_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingTop="11dp" android:paddingBottom="11dp">
        <ImageView android:id="@+id/ek_box" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="14dp" />
        <TextView android:id="@+id/ek_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FF000000" android:textSize="18sp" />
    </LinearLayout>
    <View android:id="@+id/ek_div" android:layout_width="match_parent" android:layout_height="1dp" android:background="#1F000000" />
</LinearLayout>
