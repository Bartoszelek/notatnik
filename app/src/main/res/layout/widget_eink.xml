<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ek_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/ek_page_paper" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="14dp" android:paddingBottom="12dp">

    <!-- kategorie: Zakupy, Pamiętaj… i „+” -->
    <LinearLayout android:id="@+id/ek_chips" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" />

    <View android:id="@+id/ek_line" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp"
        android:background="#33000000" />

    <ListView android:id="@+id/ek_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="4dp" android:divider="@null" android:dividerHeight="0dp" />

    <TextView android:id="@+id/ek_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:text="Pusto – stuknij „＋ Dodaj”" android:textColor="#99000000" android:textSize="16sp" android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/ek_add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="＋ Dodaj"
            android:textSize="15sp" android:textColor="#FF000000" android:background="@drawable/ek_chip" android:paddingStart="16dp"
            android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/ek_clear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Usuń odhaczone"
            android:textSize="15sp" android:textColor="#FF000000" android:background="@drawable/ek_chip" android:paddingStart="16dp"
            android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" />
    </LinearLayout>
</LinearLayout>
